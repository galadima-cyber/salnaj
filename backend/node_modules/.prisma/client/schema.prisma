generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────

enum UserRole {
  USER
  AGENT
  SUPER_AGENT
  ADMIN
  SUPER_ADMIN
}

enum KycStatus {
  UNVERIFIED
  PHONE_VERIFIED
  BVN_VERIFIED
  FULL_KYC
}

enum TxType {
  DATA
  AIRTIME
  ELECTRICITY
  CABLE_TV
  EDUCATION
  BETTING
  AIRTIME_TO_CASH
  BULK_SMS
  RECHARGE_CARD
  WALLET_FUND
  WALLET_TRANSFER
  REFERRAL_BONUS
  API_PURCHASE
}

enum TxStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
  REFUNDED
}

enum Network {
  MTN
  AIRTEL
  GLO
  ETISALAT
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ApiKeyStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

// ─── User ─────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  fullName        String
  email           String    @unique
  phone           String    @unique
  passwordHash    String
  pinHash         String?
  role            UserRole  @default(USER)
  kycStatus       KycStatus @default(UNVERIFIED)
  referralCode    String    @unique
  referredById    String?
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  isBlocked       Boolean   @default(false)
  blockReason     String?
  profilePhoto    String?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  referredBy         User?               @relation("Referrals", fields: [referredById], references: [id])
  referredUsers      User[]              @relation("Referrals")
  wallet             Wallet?
  transactions       Transaction[]
  otps               Otp[]
  notifications      Notification[]
  referralEarnings   ReferralEarning[]   @relation("ReferrerEarnings")
  referralRewards    ReferralEarning[]   @relation("RefereeRewards")
  scheduledPurchases ScheduledPurchase[]
  apiKeys            ApiKey[]
  bulkSmsJobs        BulkSmJob[]
  auditLogs          AuditLog[]

  @@index([email])
  @@index([phone])
  @@index([referralCode])
  @@index([createdAt])
}

// ─── Wallet ───────────────────────────────────────────────────

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  mainBalance     Decimal  @default(0) @db.Decimal(15, 2)
  bonusBalance    Decimal  @default(0) @db.Decimal(15, 2)
  cashbackBalance Decimal  @default(0) @db.Decimal(15, 2)
  totalFunded     Decimal  @default(0) @db.Decimal(15, 2)
  totalSpent      Decimal  @default(0) @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Transaction ──────────────────────────────────────────────

model Transaction {
  id            String    @id @default(cuid())
  userId        String
  type          TxType
  network       Network?
  phone         String?
  planId        String?
  planName      String?
  amount        Decimal   @db.Decimal(15, 2)
  fee           Decimal   @default(0) @db.Decimal(15, 2)
  status        TxStatus  @default(PENDING)
  reference     String    @unique // our reference
  providerRef   String? // VTPass reference
  paystackRef   String? // Paystack reference
  providerToken String? // electricity token / WAEC pin / etc.
  decoderNumber String?
  meterNumber   String?
  customerName  String?
  metadata      Json?
  failureReason String?
  retryCount    Int       @default(0)
  reversedAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
  @@index([type])
}

// ─── Data Plans ───────────────────────────────────────────────

model DataPlan {
  id           String   @id @default(cuid())
  network      Network
  name         String
  sizeGb       Float
  sizeLabel    String // "2GB", "500MB", etc.
  price        Decimal  @db.Decimal(10, 2)
  validityDays Int
  category     String // "SME", "GIFTING", "CORPORATE", "DIRECT"
  providerCode String // VTPass variation_code
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([network, providerCode])
  @@index([network])
  @@index([isActive])
}

// ─── OTP ──────────────────────────────────────────────────────

model Otp {
  id        String    @id @default(cuid())
  userId    String
  code      String
  purpose   String // "EMAIL_VERIFY" | "PHONE_VERIFY" | "RESET_PASSWORD" | "TRANSACTION"
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ─── Notification ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String // "TRANSACTION" | "PROMO" | "SECURITY" | "SYSTEM"
  isRead    Boolean  @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ─── Referral Earning ─────────────────────────────────────────

model ReferralEarning {
  id            String    @id @default(cuid())
  referrerId    String
  refereeId     String
  amount        Decimal   @db.Decimal(10, 2)
  type          String // "SIGNUP_BONUS" | "TRANSACTION_BONUS"
  transactionId String?
  isPaid        Boolean   @default(false)
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  referrer User @relation("ReferrerEarnings", fields: [referrerId], references: [id])
  referee  User @relation("RefereeRewards", fields: [refereeId], references: [id])

  @@index([referrerId])
}

// ─── Scheduled Purchase (Autopilot) ──────────────────────────

model ScheduledPurchase {
  id         String            @id @default(cuid())
  userId     String
  type       TxType
  network    Network?
  planId     String?
  phone      String
  amount     Decimal?          @db.Decimal(10, 2)
  frequency  ScheduleFrequency
  dayOfWeek  Int? // 0=Sunday … 6=Saturday
  dayOfMonth Int? // 1–28
  timeOfDay  String // "07:00"
  isActive   Boolean           @default(true)
  nextRunAt  DateTime
  lastRunAt  DateTime?
  runCount   Int               @default(0)
  failCount  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nextRunAt, isActive])
  @@index([userId])
}

// ─── Gift Data Code ───────────────────────────────────────────

model GiftDataCode {
  id               String    @id @default(cuid())
  senderId         String
  network          Network
  planId           String
  planName         String
  code             String    @unique // e.g. "GIFT-X4K2-MTN2G"
  amount           Decimal   @db.Decimal(10, 2)
  message          String?
  isRedeemed       Boolean   @default(false)
  redeemedById     String?
  redeemedForPhone String?
  redeemedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  @@index([code])
  @@index([senderId])
  @@index([expiresAt])
}

// ─── API Key (Resellers) ──────────────────────────────────────

model ApiKey {
  id           String       @id @default(cuid())
  userId       String
  key          String       @unique
  label        String
  status       ApiKeyStatus @default(ACTIVE)
  webhookUrl   String?
  allowedIps   String[]
  requestCount Int          @default(0)
  lastUsedAt   DateTime?
  monthlyLimit Int          @default(10000)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
}

// ─── Bulk SMS Job ─────────────────────────────────────────────

model BulkSmJob {
  id          String    @id @default(cuid())
  userId      String
  senderId    String
  message     String
  recipients  String[]
  totalCount  Int
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  costPerSms  Decimal   @db.Decimal(6, 4)
  totalCost   Decimal   @db.Decimal(10, 2)
  status      String    @default("PENDING") // PENDING|PROCESSING|DONE|FAILED
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// ─── Wallet Funding (Paystack) ────────────────────────────────

model WalletFunding {
  id             String    @id @default(cuid())
  userId         String
  amount         Decimal   @db.Decimal(15, 2)
  fee            Decimal   @default(0) @db.Decimal(10, 2)
  paystackRef    String    @unique
  paystackStatus String // "success" | "failed" | "abandoned"
  channel        String? // "card" | "bank" | "ussd"
  bank           String?
  cardLast4      String?
  isProcessed    Boolean   @default(false)
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([paystackRef])
  @@index([isProcessed])
}

// ─── Audit Log ────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  adminId   String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── System Config ────────────────────────────────────────────

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ─── Promo Banner ─────────────────────────────────────────────

model PromoBanner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String?
  actionUrl   String?
  actionLabel String?
  bgColor     String?
  isActive    Boolean   @default(true)
  startAt     DateTime?
  endAt       DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([isActive])
}
